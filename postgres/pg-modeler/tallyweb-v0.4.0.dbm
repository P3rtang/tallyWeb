<view name="phases" layers="0" collapse-mode="2" pagination="true" attribs-page="0" ext-attribs-page="0" max-obj-count="0" z-value="0">
	<schema name="v0_4"/>
	<role name="p3rtang"/>
	<comment> <![CDATA[A view akin to the old phases table
backwards compat between dev and prod]]> </comment>
	<tag name="v0.4"/>
	<position x="460" y="900"/>
	<simplecol name="uuid" type="uuid"/>
	<simplecol name="name" type="varchar"/>
	<simplecol name="count" type="integer"/>
	<simplecol name="time" type="bigint"/>
	<simplecol name="hunt_type" type="public.hunttype"/>
	<simplecol name="has_charm" type="boolean"/>
	<simplecol name="created_at" type="timestamp"/>
	<simplecol name="owner_uuid" type="uuid"/>
	<simplecol name="parent_uuid" type="uuid"/>
	<simplecol name="success" type="boolean"/>
	<simplecol name="last_edit" type="timestamp"/>
	<simplecol name="is_deleted" type="boolean"/>
	<simplecol name="step_size" type="integer"/>
	<definition> <![CDATA[SELECT 
	co.uuid,
	phase.name,
	phase.count,
	phase.time,
	phase.step_size,
	phase.parent as parent_uuid,
	co.owner as owner_uuid,
	co.created_on as created_at,
	co.changed_on as last_edit,
	CASE WHEN deleted_on IS NULL THEN false ELSE true END as is_deleted,
	ps.hunt_type,
	ps.has_charm,
	ps.is_success as success
FROM phase

JOIN countable_object AS co
ON 
	co.uuid = phase.uuid AND
	co.type = phase.type

JOIN countable_pokemon_setting as ps
ON 
	co.uuid = ps.uuid AND
	co.type = ps.type]]> </definition>
</view>

