<view name="counters" layers="0" collapse-mode="2" max-obj-count="0" z-value="0">
	<schema name="v0_4"/>
	<role name="p3rtang"/>
	<tag name="v0.4"/>
	<position x="760" y="900"/>
	<simplecol name="uuid" type="uuid"/>
	<simplecol name="name" type="varchar"/>
	<simplecol name="owner_uuid" type="uuid"/>
	<simplecol name="created_at" type="timestamp"/>
	<simplecol name="last_edit" type="timestamp"/>
	<simplecol name="is_deleted" type="boolean"/>
	<definition> <![CDATA[SELECT 
	co.uuid,
	counter.name,
	co.owner AS owner_uuid,
	co.created_on AS created_at,
	co.changed_on AS last_edit,
	co.deleted_on IS NOT NULL as is_deleted
FROM v0_4.countable_object AS co

JOIN v0_4.counter
ON co.uuid = counter.uuid AND co.type = counter.type]]> </definition>
</view>

