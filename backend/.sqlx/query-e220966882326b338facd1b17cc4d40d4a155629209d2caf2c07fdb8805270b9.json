{
  "db_name": "PostgreSQL",
  "query": "\n        select \n            users.uuid,\n            users.username,\n            tokens.uuid as token,\n            tokens.expire_on as token_expire,\n            users.email\n        from \n            users\n        join\n            auth_tokens as tokens\n        on\n            tokens.user_uuid = users.uuid\n        where\n            users.username = $1\n        ",
